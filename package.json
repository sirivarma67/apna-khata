    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.4.4"
  }
